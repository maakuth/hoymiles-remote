mqtt:
  host: "127.0.0.1"
  port: 1883
  user: ""
  password: ""
  topic_prefix: "hoymiles"
  device_id: "hoymiles_remote"

dtu:
  host: "192.168.1.100"
  serial: 123456781234  # DTU serial number
  inverter_serial: 123456781234  # Inverter serial number

battery:
  max_power: 3600  # Maximum charge/discharge power in Watts
  rev_soc: 10      # Reserved SOC (used by HYT inverters)
  peak_soc: 100    # Peak SOC (used by HYT inverters)
